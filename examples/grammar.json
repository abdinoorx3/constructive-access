{
  "schema": "constructive-access-contract-v1",
  "name": "Action-only grammar forces a complete drive and read experiment",
  "question": "Can the available controlled readout distinguish the two candidate response mechanisms?",
  "target": {
    "name": "response class",
    "labels": [
      "toward state 0",
      "toward state 1"
    ]
  },
  "models": [
    {
      "name": "mechanism A",
      "initial": [
        "1/2",
        "1/2"
      ],
      "actions": {
        "read": {
          "0": [
            [
              1,
              0
            ],
            [
              0,
              0
            ]
          ],
          "1": [
            [
              0,
              0
            ],
            [
              0,
              1
            ]
          ]
        },
        "drive": {
          "done": [
            [
              "3/4",
              "1/4"
            ],
            [
              "3/4",
              "1/4"
            ]
          ]
        }
      }
    },
    {
      "name": "mechanism B",
      "initial": [
        "1/2",
        "1/2"
      ],
      "actions": {
        "read": {
          "0": [
            [
              1,
              0
            ],
            [
              0,
              0
            ]
          ],
          "1": [
            [
              0,
              0
            ],
            [
              0,
              1
            ]
          ]
        },
        "drive": {
          "done": [
            [
              "1/4",
              "3/4"
            ],
            [
              "1/4",
              "3/4"
            ]
          ]
        }
      }
    }
  ],
  "resources": {
    "charge_name": "operation count",
    "unit": "operation",
    "meaning": "operation_count",
    "action_costs": {
      "read": 1,
      "drive": 2
    },
    "per_record_overhead": 1,
    "calibration": "Each read is one counted operation, each drive two; fresh preparation is one additional operation. This is an operation model, not a measured energy model.",
    "included": [
      "read and drive calls",
      "one preparation per complete record"
    ],
    "excluded": [
      "apparatus heating",
      "classical computation",
      "storage"
    ]
  },
  "preparation": {
    "description": "Fresh independent preparation in the listed initial distribution before every complete action sequence; a single fixed hypothesis governs all records.",
    "iid_records": true
  },
  "design": {
    "target_average_error": "1/10"
  },
  "grammar": {
    "states": [
      "start",
      "driven",
      "done"
    ],
    "start": "start",
    "accepting": [
      "done"
    ],
    "transitions": [
      {
        "state": "start",
        "action": "drive",
        "target": "driven"
      },
      {
        "state": "driven",
        "action": "read",
        "target": "done"
      }
    ]
  }
}
